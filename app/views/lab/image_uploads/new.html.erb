<div class="p-10 flex flex-col gap-4">
  <h1 class="font-bold text-3xl">이미지 업로드</h1>
  <form 
    action="/lab/image-uploads" 
    method="post"
    enctype="multipart/form-data"
    class="flex flex-col items-start gap-4">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">대충 아무런 이름 ㄱㄱ</legend>
      <input class="input" name="test_object[name]">
    </fieldset>
    <%= render "partials/image_preview_v2", {
      isMultiple: true,
      name: "test_object[images][]"
    } %>
    <button class="btn btn-primary">업로드</button>
  </form>
</div>