<div class="flex flex-col gap-4">
  <a href="/lab/image-uploads">뒤로가기</a>
  <div
    class="flex flex-col gap-4 bg-base-100">
    <p class="text-2xl">#<%= @test_object.name %></p>
    <div class="flex flex-col gap-2">
      <% @test_object.images.each do |image| %>
        <%= render "partials/image",  
          url: url_for(image),
          dominant_color: image.blob.metadata["dominant_color"],
          width: "w-36",
          height: "h-36",
          alt: @test_object.name %>
        <%= image.inspect %>
      <% end %>
    </div>
  </div>
</div>