<div class="flex flex-col gap-4">
  <a href="/lab/image-uploads">뒤로가기</a>
  <div
    class="flex flex-col gap-4 bg-base-100">
    <p class="text-2xl">#<%= @test_object.name %></p>
    <div class="flex flex-col gap-2">
      <% @test_object.images.each do |image| %>
        <img src="<%= rails_blob_url(image) %>" class="w-20 object-contain"/>
        <%= image.inspect %>
      <% end %>
    </div>
  </div>
</div>