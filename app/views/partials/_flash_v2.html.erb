<!-- 작업에 성공한 경우 노출 -->
<% if flash[:notice].present? %>
  <div data-controller="flash" role="alert" class="alert alert-info alert-soft flex justify-between">
    <span><%= flash[:notice] %></span>
    <button data-action="flash#onClose">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>

<!-- 작업에 실패한 경우 노출 -->
<% if flash[:alert].present? %>
  <div data-controller="flash" role="alert" class="alert alert-error alert-soft flex justify-between">
    <span><%= flash[:alert] %></span>
    <button data-action="flash#onClose">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>