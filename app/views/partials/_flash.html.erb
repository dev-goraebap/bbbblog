<!-- 작업에 성공한 경우 노출 -->
<% if flash[:notice].present? %>
  <div role="alert" class="alert alert-info alert-soft">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<!-- 작업에 실패한 경우 노출 -->
<% if flash[:alert].present? %>
  <div role="alert" class="alert alert-error alert-soft">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>