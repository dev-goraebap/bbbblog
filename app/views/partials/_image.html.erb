<%# app/views/components/_lazy_image.html.erb %>
  
<div
  data-controller="image-loader"
  data-image-loader-target="container"
  class="relative overflow-hidden transition-colors duration-700
  <%= local_assigns[:width] || 'w-full' %> <%= local_assigns[:height] || 'h-full' %>
  "
  style="background-color: <%= local_assigns[:dominant_color] || '#f0f0f0' %> ;"
>
  <img
    data-image-loader-target="image"
    src="<%= local_assigns[:url] %>"
    loading="lazy"
    class="w-full h-full object-cover transition-opacity duration-500 opacity-0"
    alt="<%= local_assigns[:alt] || '' %>">
</div>