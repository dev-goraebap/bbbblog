<%
  # 파라미터
  isMultiple = local_assigns[:isMultiple] || false
%>

<div
  data-controller="image-preview-v2"
  data-action="drop->image-preview-v2#onDrop 
    dragover->image-preview-v2#onDragOver 
    dragleave->image-preview-v2#onDragLeave"
  class="flex flex-col gap-4 w-full md:w-[300px]">
  <label
    data-image-preview-v2-target="label"
    class="flex flex-col items-center w-full p-4 border-2 border-dashed border-neutral-content rounded-3xl cursor-pointer">
    <div>
      <svg class="size-10 text-neutral/50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
    </div>
    <div class="flex flex-col items-center text-neutral/80">
      <p><strong>Drag and drop.</strong> or</p>
      <p><strong>Browse files</strong></p>
    </div>

    <!-- 파일 인풋 -->
    <input
      data-image-preview-v2-target="fileInput"
      data-action="image-preview-v2#onChange"
      type="file" 
      class="hidden"
      accept="image/*"
      <%= isMultiple ? 'multiple' : '' %>
    />
  </label>

  <div 
    data-image-preview-v2-target="previewArea"
    class="px-2 flex flex-col gap-4">
    <!-- JS를 통해 파일 갯수에 따라 template 영역의 UI를 동적으로 로드 -->
  </div>

  <!-- 이미지 미리보기 박스 -->
  <template data-image-preview-v2-target="previewItemTemplate">
    <div class="flex gap-2 justify-start items-center">
      <div class="bg-neutral-content w-16 h-10 min-w-16 min-h-10 max-w-16 max-h-10 overflow-hidden">
        <img x-data="img" alt="preview image" class="w-full h-full">
      </div>
      <div class="overflow-hidden">
        <p x-data="name" class="text-sm text-neutral truncate whitespace-nowrap">
          <!-- upload-file-name.jpg -->
        </p>
        <div class="flex gap-2 text-xs text-neutral/50">
          <span x-data="size">
            <!-- 760,000 MB -->
          </span>
          <span x-data="type">
            <!-- IMAGE/JPG -->
          </span>
        </div>
      </div>
    </div>
  </template>

  <!-- 초기화 버튼 -->
  <template data-image-preview-v2-target="clearButtonTemplate">
    <button
      data-action="image-preview-v2#onClear"
      type="button" 
      class="btn btn-soft btn-warning text-xs">
      초기화
    </button>
  </template>
</div>